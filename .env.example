DATABASE_URL="postgresql://traza:traza@localhost:5435/traza"
# Obligatorio en producción (mín. 32 caracteres): sin él la app no arranca.
# Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
NEXT_PUBLIC_APP_NAME="TRAZA"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Automatizaciones (opcional)
N8N_WEBHOOK_URL=""
# Habilita /api/cron/verificar-vencimientos (llamar 1 vez por dia desde un
# Schedule Trigger de n8n o un cron externo, pasando ?secret=... o el header
# x-cron-secret). Sin este valor el endpoint queda deshabilitado.
CRON_SECRET=""

# Hosts internos permitidos como destino de webhooks (separados por coma), ej.
# "n8n" si n8n corre en la misma red de Docker. En producción, cualquier otro
# host privado/localhost se rechaza para evitar SSRF.
WEBHOOK_ALLOWED_HOSTS=""

# Content-Security-Policy: arranca en Report-Only (las violaciones se loguean
# como "[csp]"). Con los logs en cero, poner "true" para que bloquee.
CSP_ENFORCE=""

# Self-hosting detrás de un proxy que termina TLS (nginx, Caddy, balanceador):
# "true" redirige a https las requests que llegan con x-forwarded-proto=http.
# En Vercel no hace falta (redirige solo).
FORCE_HTTPS=""

# Integración directa con n8n (opcional): permite que TRAZA dispare workflows
# puntuales de n8n (ver "Probar conexión con n8n" en Configuración). Distinto
# de N8N_WEBHOOK_URL/WebhookConfig, que son los webhooks salientes por evento
# configurables desde el panel.
# URL base de tu instancia de n8n (sin barra final), ej: http://localhost:5678
N8N_BASE_URL=""
# Secreto compartido enviado en el header "X-Traza-Secret" a cada workflow.
# Configurá la misma condición en el nodo Webhook de n8n para validarlo.
N8N_WEBHOOK_SECRET=""

# Email (opcional, preparado para futuro proveedor SMTP)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="TRAZA <no-reply@traza.local>"

# WhatsApp (opcional, preparado para futura integración vía n8n)
WHATSAPP_WEBHOOK_URL=""

# Pagos (opcional, preparado para integración futura — NO credenciales reales)
MERCADOPAGO_ACCESS_TOKEN=""
STRIPE_SECRET_KEY=""
